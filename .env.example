# ===========================================================================
# Media Server v2 — configurazione
# Copia questo file in .env e compila i valori:  cp .env.example .env
# ===========================================================================

# Fuso orario
TZ=Europe/Rome

# Utente/gruppo con cui girano i container (owner dei file su MEDIA_ROOT).
# Usa il TUO utente:  id -u  e  id -g   (sul primo utente Debian è tipicamente 1000)
PUID=1000
PGID=1000

# --- Storage --------------------------------------------------------------
# Root UNICA dei dati = punto di mount del DISCO ESTERNO (vedi SETUP.md).
# torrents/ e media/ devono stare sullo STESSO disco, altrimenti niente hardlink.
#   ${MEDIA_ROOT}/torrents/{movies,tv}   <- qBittorrent scarica qui
#   ${MEDIA_ROOT}/media/{movies,tv}      <- libreria Jellyfin (import Radarr/Sonarr)
MEDIA_ROOT=/mnt/media

# --- Rete -----------------------------------------------------------------
# IP del mini PC nella rete di casa (usato dai link della dashboard Homepage)
SERVER_IP=192.168.1.10
# Host ammessi da Homepage v1.x (obbligatorio). Metti IP:porta della dashboard.
HOMEPAGE_ALLOWED_HOSTS=192.168.1.10:3000

# --- Transcoding hardware (opzionale) -------------------------------------
# GID del gruppo 'render' sul mini PC. Ricavalo con:  getent group render
# Poi decommenta le righe devices/group_add nel docker-compose.yml (jellyfin).
RENDER_GID=

# GID del gruppo 'docker' sul mini PC (per i widget di stato di Homepage).
# Ricavalo con:  getent group docker   (spesso 999)
DOCKER_GID=999

# --- API key dei servizi (COMPILARE DOPO IL PRIMO AVVIO) ------------------
# Le trovi nella UI di ogni app: Settings > General > API Key.
# Servono solo a far vivere i widget di Homepage; lasciandole vuote i widget
# semplicemente non si popolano (i servizi funzionano comunque).
JELLYFIN_API_KEY=
RADARR_API_KEY=
SONARR_API_KEY=
PROWLARR_API_KEY=
BAZARR_API_KEY=
QBIT_USER=admin
QBIT_PASS=
