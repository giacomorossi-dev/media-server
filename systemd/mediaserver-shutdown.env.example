# Config del webhook di spegnimento. Copiare in /etc/mediaserver-shutdown.env
# (proprietario root:giacomo, permessi 0640: contiene il token).

# Porta su cui ascolta il webhook sul mini PC.
LISTEN_PORT=9977

# Token OBBLIGATORIO: sostituisci con una stringa casuale lunga.
# Comparira' nell'URL che chiami:  /shutdown?token=<QUESTO>
# Generane uno con:  openssl rand -hex 16
SHUTDOWN_TOKEN=CAMBIA-QUESTO-CON-UNA-STRINGA-CASUALE-LUNGA

# Comando di spegnimento (via sudo NOPASSWD, vedi mediaserver-shutdown.sudoers).
POWEROFF_CMD=sudo /usr/bin/systemctl poweroff
